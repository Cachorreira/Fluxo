# Copie este arquivo para ".env" e ajuste os valores. O .env NÃO vai para o Git.
PORTA=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fluxo
DB_USER=postgres
DB_PASSWORD=postgres

# Gere um segredo longo e aleatório (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SEGREDO=troque-este-segredo
JWT_VALIDADE=8h

# Origem do frontend autorizada a chamar a API (vazio = qualquer origem, só em desenvolvimento)
CORS_ORIGEM=

# Primeiro Gerente criado pelo "npm run seed"
SEED_LOGIN=gerente
SEED_SENHA=fluxo2026
